{
  "name": "local-board",
  "version": "0.5.0",
  "description": "Repo-native Markdown ticket board and CLI for orchestrating local AI agent workflows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicholasMTElliott/local-board.git"
  },
  "keywords": [
    "kanban",
    "tickets",
    "board",
    "ai-agents",
    "workflow",
    "orchestration",
    "cli",
    "markdown"
  ],
  "bin": {
    "local-board": "./bin/local-board.js"
  },
  "files": [
    "bin",
    "src",
    "resources",
    "install.mjs",
    "SKILL.md",
    "SKILL_TEAM.md",
    "agents",
    "skills",
    "hooks"
  ],
  "scripts": {
    "check": "node ./scripts/check.mjs",
    "test": "node --test",
    "validate": "node ./bin/local-board.js validate",
    "sync-resources": "node ./scripts/sync-resources.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
